# Xenom Intel — local environment
# Copy this file to `.env` and adjust values. NEVER commit a real `.env`.

# --- Application ---
APP_NAME=xenom-intel-api
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
SEARCH_PROVIDER=unconfigured
# Use fixture for synthetic local demos, or brave with a real key in local `.env`.
BRAVE_API_KEY=
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# --- PostgreSQL/pgvector ---
# Use a local-only throwaway password.
POSTGRES_USER=xenom
POSTGRES_PASSWORD=change_me_local
POSTGRES_DB=xenom_intel
POSTGRES_PORT=5433

# Async SQLAlchemy connection URL used by the app and Alembic.
# For host runs (venv/pytest/alembic) use localhost. The container is published
# on host port 5433 to avoid colliding with any host-native PostgreSQL on 5432.
# docker-compose overrides this to use the "postgres" service host internally.
DATABASE_URL=postgresql+asyncpg://xenom:change_me_local@localhost:5433/xenom_intel

# --- Auth / JWT ---
# The secret below is a DEV placeholder. Override with a strong random value
# in any non-local environment. Never commit a real secret.
JWT_SECRET=dev-insecure-secret-change-me-please-32-bytes-min
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=xenom-intel
JWT_AUDIENCE=xenom-intel-api

# Development-only password for the seeded dev user (dev@xenom.local).
# Optional: if unset, the seeded user gets an unusable hash and cannot log in.
# NEVER set a real/production password here.
DEV_USER_PASSWORD=dev-only-password-123

# --- Embeddings (optional; "none" keeps search lexical-only, sends nothing anywhere) ---
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=

# --- LLM enrichment (optional; empty GROQ_API_KEY leaves it not_configured, nothing is simulated) ---
# LLM_PROVIDER: none | anthropic | openai_compatible | groq
# Groq's endpoint is OpenAI-compatible, so it reuses the existing client — no separate LLM system.
# NEVER commit a real key here — this file is an example; paste it only into your local, untracked `.env`.
LLM_PROVIDER=none
GROQ_API_KEY=
GROQ_MODEL=
